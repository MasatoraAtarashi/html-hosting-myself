/**
 * テスト用の wrangler 設定（vitest-pool-workers が読む）。
 * 本番の wrangler.jsonc とバインディング構成を揃えること。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "html-hosting-myself-test",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./test/worker.ts",
  // 本番と同じく public/ を Static Assets として配信し、/favicon.* をテストできるようにする
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "test-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "test-hosts",
    },
  ],
  "vars": {
    "API_TOKEN": "test-api-token",
  },
}
