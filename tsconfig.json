{
  "compilerOptions": {
    "checkJs": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client", "@cloudflare/vitest-pool-workers/types"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "workers/**/*",
    "server/**/*",
    "db/**/*",
    "test/**/*",
    "vitest.config.ts",
    "drizzle.config.ts",
    "worker-configuration.d.ts"
  ]
}
