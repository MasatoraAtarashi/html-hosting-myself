{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.rulesync/hooks/security-guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git branch)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git status)",
      "Bash(pnpm run *)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Edit(app/**)",
      "Edit(db/**)",
      "Edit(server/**)",
      "Edit(src/**)",
      "Edit(test/**)",
      "Read(!.dev.vars.example)"
    ],
    "ask": [
      "Bash",
      "Bash(git push --force*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Read(.dev.vars)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
